# wecom-calendar-cli environment configuration
# Copy to .env and fill in. All variables are optional and overridable by CLI flags.

# --- Service settings (shareable; the fields `config set-context` writes) ---
# CalDAV server root (WeCom / Tencent Exmail)
WECOM_CALENDAR_SERVER=https://caldav.wecom.work/
# Auth scheme. basic is the only one WeCom CalDAV accepts.
WECOM_CALENDAR_AUTH_SCHEME=basic
# Optional page of your own about obtaining the CalDAV password. Display only:
# `auth guide` shows it and the CLI never requests it.
WECOM_CALENDAR_CREDENTIAL_URL=

# --- Personal authentication (Basic; never copied into a team preset) ---
# Username is your full WeCom email address.
WECOM_CALENDAR_USERNAME=
# The app-specific CalDAV password. Get it in the WeCom mobile app:
#   Workbench -> Calendar -> settings -> Sync to other calendars.
# NOTE: fetching a new password there invalidates the previous one.
WECOM_CALENDAR_PASSWORD=

# Default output format: json | table | ndjson
WECOM_CALENDAR_FORMAT=json

# Session read-only posture: 1 blocks every local write before it happens
# (override per invocation with --allow-writes)
WECOM_CALENDAR_CLI_READ_ONLY=
